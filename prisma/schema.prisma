model LivestockMovement {
  id             String @id
  tenantId       String
  fromFarmId     String
  toFarmId       String
  fromAreaId     String?
  toAreaId       String?
  movementDate   DateTime
  reason         String
  notes          String?
  actorUserId    String
  requestKey     String
  createdAt      DateTime @default(now())
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromFarm       Farm @relation("MovementFromFarm", fields: [fromFarmId], references: [id], onDelete: Restrict)
  toFarm         Farm @relation("MovementToFarm", fields: [toFarmId], references: [id], onDelete: Restrict)
  animals        LivestockMovementItem[]
  @@unique([tenantId, requestKey])
  @@index([tenantId, fromFarmId, movementDate])
  @@index([tenantId, toFarmId, movementDate])
}
model LivestockMovementItem {
  id         String @id
  tenantId   String
  movementId String
  animalId   String
  codeSnapshot String
  movement   LivestockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  animal     Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)
  @@unique([movementId, animalId])
  @@index([tenantId, animalId])
}


// ERP agropecuario V1: los códigos de estado se validan en el servicio.
// Los importes están expresados en centavos de su moneda ORIGINAL, sin tasas implícitas.
model FarmErpPartner {
  id        String @id
  tenantId  String
  farmId    String
  name      String
  kind      String // SUPPLIER, CUSTOMER, BOTH
  rif       String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  farm      Farm @relation(fields:[farmId],references:[id],onDelete:Cascade)
  moves     FarmErpStockMove[]
  finances  FarmErpFinance[]
  @@unique([farmId,name])
  @@index([tenantId,farmId])
}
model FarmErpItem {
  id          String @id
  tenantId    String
  farmId      String
  sku         String
  name        String
  kind        String // SUPPLY, ASSET
  unit        String
  quantity    Decimal @default(0) @db.Decimal(16,3)
  minQuantity Decimal @default(0) @db.Decimal(16,3)
  currency    String @default("USD")
  unitCostCents Int?
  serial      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  farm        Farm @relation(fields:[farmId],references:[id],onDelete:Cascade)
  moves       FarmErpStockMove[]
  @@unique([farmId,sku])
  @@index([tenantId,farmId,kind])
}
model FarmErpStockMove {
  id          String @id
  tenantId    String
  farmId      String
  itemId      String
  partnerId   String?
  kind        String // RECEIPT, USE, ADJUST_PLUS, ADJUST_MINUS
  quantity    Decimal @db.Decimal(16,3)
  unitCostCents Int?
  note        String?
  requestKey  String
  actorUserId String
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  farm        Farm @relation(fields:[farmId],references:[id],onDelete:Cascade)
  item        FarmErpItem @relation(fields:[itemId],references:[id],onDelete:Restrict)
  partner     FarmErpPartner? @relation(fields:[partnerId],references:[id],onDelete:Restrict)
  @@unique([farmId,requestKey])
  @@index([tenantId,farmId,createdAt])
}
model FarmErpFinance {
  id          String @id
  tenantId    String
  farmId      String
  partnerId   String?
  kind        String // INCOME, EXPENSE, PAYABLE, RECEIVABLE, PAYMENT_IN, PAYMENT_OUT
  currency    String
  amountCents Int
  description String
  reference   String?
  relatedId   String? // payment links to AP/AR within same farm
  dueAt       DateTime?
  occurredAt  DateTime
  requestKey  String
  actorUserId String
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  farm        Farm @relation(fields:[farmId],references:[id],onDelete:Cascade)
  partner     FarmErpPartner? @relation(fields:[partnerId],references:[id],onDelete:Restrict)
  @@unique([farmId,requestKey])
  @@index([tenantId,farmId,occurredAt])
  @@index([farmId,relatedId])
}
model FarmErpStaff {
  id          String @id
  tenantId    String
  farmId      String
  employeeId  String
  role        String
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  farm        Farm @relation(fields:[farmId],references:[id],onDelete:Cascade)
  employee    Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  @@unique([farmId,employeeId])
  @@index([tenantId,farmId,active])
}
model FarmErpPayroll {
  id          String @id
  tenantId    String
  farmId      String
  employeeId  String
  startAt     DateTime
  endAt       DateTime
  currency    String
  baseCents   Int
  extraCents  Int
  deductionCents Int
  netCents    Int
  status      String @default("DRAFT") // sólo borradores en V1
  note        String?
  actorUserId String
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  farm        Farm @relation(fields:[farmId],references:[id],onDelete:Cascade)
  employee    Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  @@unique([farmId,employeeId,startAt,endAt,currency])
  @@index([tenantId,farmId,createdAt])
}

/**
 * Farm scopes are assigned inside each tenant. Tenant owners and admins are
 * intentionally global; all other roles require an explicit row for each farm.
 */
model TenantFarmAccess {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  farmId    String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId, farmId])
  @@index([tenantId, farmId])
}

model TenantInvitation {
  id          String   @id @default(cuid())
  tenantId    String
  email       String
  role        TenantRole
  farmIds     Json
  tokenHash   String   @unique
  status      String   @default("PENDING")
  createdById String
  acceptedById String?
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, email])
}

/**
 * Verified identity stays in Clerk; profile fields are declared by the user
 * or company admin and are not automatically credential-verified.
 * One professional may be assigned to multiple farms through TenantFarmAccess.
 */
model VeterinaryProfessionalProfile {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String
  fullName              String
  licenseNumber         String
  registrationAuthority String?
  specialty             String?
  phone                 String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaccinations          AnimalVaccinationRecord[] @relation("VaccinationVeterinarian")
  treatments            AnimalTreatmentRecord[] @relation("TreatmentVeterinarian")

  @@unique([tenantId, userId])
  @@index([tenantId, licenseNumber])
}

/** Shared lifetime pilot cap, across all tenants and users (integer micro-USD). */
model GanadiaAiPilotBudget {
  id               String   @id
  spentMicroUsd    Int      @default(0)
  reservedMicroUsd Int      @default(0)
  updatedAt        DateTime @updatedAt
}

/** One reservation per billable OpenAI API response. Unknown charges stay held. */
model GanadiaAiPilotAttempt {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  status           String   @default("RESERVED")
  reservedMicroUsd Int
  billedMicroUsd   Int      @default(0)
  inputTokens      Int?
  outputTokens     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, status])
  @@index([tenantId, createdAt])
}

/**
 * User-owned persistent chat. accessHash is a server-generated fingerprint of
 * tenant, user, current role and authorized farm IDs. Permission changes
 * cannot expose old ERP-sensitive answers to an account with reduced access.
 */
model GanadiaAiConversation {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  accessHash  String   @db.VarChar(64)
  generation  Int      @default(0)
  saleFlow    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    GanadiaAiMessage[]

  @@unique([tenantId, userId, accessHash])
  @@index([userId, updatedAt])
}

/**
 * User/assistant turns are persisted server-side and sorted by database
 * sequence, never by client timestamps. Clearing the chat deletes these rows.
 */
model GanadiaAiMessage {
  id             String   @id @default(cuid())
  sequence       BigInt   @unique @default(autoincrement())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  conversation   GanadiaAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
}

enum LivestockInventoryStatus {
  ACTIVE
  SOLD
}
model LivestockSale {
  id String @id @default(cuid())
  tenantId String
  farmId String
  number String
  status String @default("DRAFT")
  buyerName String
  buyerDocument String?
  destination String?
  saleDate DateTime
  currency String
  pricePerKgCents Int
  totalWeightKg Decimal @db.Decimal(12,2)
  totalCents Int
  notes String?
  requestKey String
  createdById String
  confirmedById String?
  confirmedAt DateTime?
  insaiPermitNumber String?
  guideData Json?
  verificationToken String? @unique
  insaiPermitFileId String?
  insaiPermitAttachedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  farm Farm @relation(fields:[farmId],references:[id],onDelete:Restrict)
  createdBy User @relation("SaleCreator",fields:[createdById],references:[id],onDelete:Restrict)
  confirmedBy User? @relation("SaleConfirmer",fields:[confirmedById],references:[id],onDelete:Restrict)
  items LivestockSaleItem[]
  @@unique([tenantId,number])
  @@unique([tenantId,requestKey])
  @@index([tenantId,farmId,createdAt])
