}
model LivestockSaleItem {
  id String @id @default(cuid())
  tenantId String
  saleId String
  animalId String
  codeSnapshot String
  sexSnapshot String
  weightKg Decimal @db.Decimal(10,2)
  weightSource String
  lastWeighedAt DateTime?
  subtotalCents Int
  sale LivestockSale @relation(fields:[saleId],references:[id],onDelete:Restrict)
  animal Animal @relation(fields:[animalId],references:[id],onDelete:Restrict)
  @@unique([saleId,animalId])
  @@index([tenantId,animalId])
}


